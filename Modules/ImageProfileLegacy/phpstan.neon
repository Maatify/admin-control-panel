includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:

    # -------------------------------------------------------------------------
    # Analysis level: 10 (max) — all rules enabled
    # -------------------------------------------------------------------------
    level: 10

    # -------------------------------------------------------------------------
    # Source paths
    # All five source trees are analysed. Tests are excluded from the main
    # analysis because they intentionally exercise edge cases (e.g. passing
    # null where non-null is expected) and have their own relaxed rule set.
    # -------------------------------------------------------------------------
    paths:
        - src
        - Application
        - Infrastructure
        - Adapter
        - Storage

    # -------------------------------------------------------------------------
    # Exclusions
    # -------------------------------------------------------------------------
    excludePaths:
        - vendor
        - tests
        - build (?)

    # -------------------------------------------------------------------------
    # Strict behaviour
    # -------------------------------------------------------------------------
    strictRules:
        allRules: true

    reportUnmatchedIgnoredErrors: true

    # -------------------------------------------------------------------------
    # PHP version
    # Must match the minimum requirement declared in composer.json (8.2).
    # -------------------------------------------------------------------------
    phpVersion: 80200

    # -------------------------------------------------------------------------
    # Bootstrap
    # Vendor autoloader so PHPStan can resolve class types from dependencies.
    # -------------------------------------------------------------------------
    bootstrapFiles:
        - vendor/autoload.php
