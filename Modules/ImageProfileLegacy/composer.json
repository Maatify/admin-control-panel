{
    "name": "maatify/image-profile-legacy",
    "description": "Reusable image-profile definition and validation package — framework-agnostic core.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mohamed Abdulalim",
            "email": "mohamed@maatify.dev",
            "homepage": "https://www.maatify.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "psr/http-message": "^1.1 || ^2.0",
        "aws/aws-sdk-php": "^3.0",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "suggest": {
        "psr/http-message": "Required to use SlimUploadedFileAdapter (PSR-7 upload objects).",
        "aws/aws-sdk-php": "Required to use DoSpacesImageStorage (DigitalOcean Spaces / S3).",
        "ext-gd": "Required to use NativeImageProcessor / NativeImageVariantGenerator (resize, optimize, variant generation). Not needed for validation-only usage.",
        "ext-fileinfo": "Required to use DoSpacesImageStorage, which detects MIME type via finfo before upload.",
        "ext-pdo": "Required to use PdoImageProfileProvider / PdoImageProfileRepository (PDO-backed persistence). Use ArrayImageProfileProvider to avoid this dependency."
    },
    "autoload": {
        "psr-4": {
            "Maatify\\ImageProfileLegacy\\": "src/",
            "Maatify\\ImageProfileLegacy\\Adapter\\": "Adapter/",
            "Maatify\\ImageProfileLegacy\\Application\\": "Application/",
            "Maatify\\ImageProfileLegacy\\Infrastructure\\": "Infrastructure/",
            "Maatify\\ImageProfileLegacy\\Storage\\": "Storage/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maatify\\ImageProfileLegacy\\tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "keywords": [
        "maatify",
        "image",
        "profile",
        "validation",
        "upload"
    ],
    "homepage": "https://github.com/Maatify/admin-control-panel/tree/main/Modules/ImageProfileLegacy",
    "support": {
        "source": "https://github.com/Maatify/admin-control-panel/tree/main/Modules/ImageProfileLegacy",
        "issues": "https://github.com/Maatify/admin-control-panel/issues"
    }
}
