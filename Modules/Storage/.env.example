# Storage Module Configuration
# Copy this file to .env and fill in your actual values

# Storage driver: 'local' or 'do_spaces'
STORAGE_DRIVER=local

# ========================
# LOCAL FILESYSTEM STORAGE
# ========================

# Base path for storing uploaded files (should be writable)
LOCAL_BASE_PATH=/var/www/storage/uploads

# Base URL for accessing stored files (relative to domain)
LOCAL_BASE_URL=/uploads

# ========================
# DIGITALOCEAN SPACES
# ========================

# DigitalOcean API credentials
DO_SPACES_KEY=your-api-key-here
DO_SPACES_SECRET=your-api-secret-here

# DigitalOcean Spaces endpoint (choose your region)
# Available regions: nyc3, sfo3, ams3, sgp1, blr1, tor1
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Your DO Spaces bucket name
DO_SPACES_BUCKET=my-bucket-name

# DO Spaces region (must match endpoint)
DO_SPACES_REGION=nyc3

# CDN URL for cached access (optional but recommended for production)
DO_SPACES_CDN_URL=https://my-bucket-name.nyc3.cdn.digitaloceanspaces.com

# ACL for uploaded files: 'public-read' or 'private'
DO_SPACES_ACL=public-read

# ---------------------------------------------------------
# Multi-Disk Storage (Optional - for advanced setups)
# ---------------------------------------------------------
#
# Configure separate DigitalOcean Spaces buckets for different
# media types and access levels. Use this when you need:
#
# ✅ Public images accessible via CDN
# ✅ Private documents requiring signed URLs
# ✅ Public videos with CDN distribution
# ✅ Private courses with authentication
# ✅ Public podcasts with streaming
# ✅ Private voice messages with expiration
#
# Each media type can have independent:
#   - Buckets (PUBLIC_IMAGES_BUCKET, PRIVATE_IMAGES_BUCKET, etc.)
#   - API credentials (PUBLIC_IMAGES_KEY, PRIVATE_IMAGES_KEY, etc.)
#   - Regions (PUBLIC_IMAGES_REGION, PRIVATE_IMAGES_REGION, etc.)
#   - CDN URLs (PUBLIC_IMAGES_CDN only, private has no CDN)
#   - ACLs (public-read for public, private for private)
#

# ========== PUBLIC IMAGES (CDN Accessible) ==========
PUBLIC_IMAGES_KEY=
PUBLIC_IMAGES_SECRET=
PUBLIC_IMAGES_ENDPOINT=https://fra1.digitaloceanspaces.com
PUBLIC_IMAGES_BUCKET=
PUBLIC_IMAGES_REGION=fra1
PUBLIC_IMAGES_CDN=https://your-public-images-bucket.fra1.cdn.digitaloceanspaces.com

# ========== PRIVATE IMAGES (Private ACL - signed URLs generated separately) ==========
PRIVATE_IMAGES_KEY=
PRIVATE_IMAGES_SECRET=
PRIVATE_IMAGES_ENDPOINT=https://fra1.digitaloceanspaces.com
PRIVATE_IMAGES_BUCKET=
PRIVATE_IMAGES_REGION=fra1

# ========== PUBLIC VIDEOS (CDN Accessible) ==========
PUBLIC_VIDEOS_KEY=
PUBLIC_VIDEOS_SECRET=
PUBLIC_VIDEOS_ENDPOINT=https://fra1.digitaloceanspaces.com
PUBLIC_VIDEOS_BUCKET=
PUBLIC_VIDEOS_REGION=fra1
PUBLIC_VIDEOS_CDN=https://your-public-videos-bucket.fra1.cdn.digitaloceanspaces.com

# ========== PRIVATE VIDEOS (Private ACL - signed URLs generated separately) ==========
PRIVATE_VIDEOS_KEY=
PRIVATE_VIDEOS_SECRET=
PRIVATE_VIDEOS_ENDPOINT=https://fra1.digitaloceanspaces.com
PRIVATE_VIDEOS_BUCKET=
PRIVATE_VIDEOS_REGION=fra1

# ========== PUBLIC AUDIO (CDN Accessible) ==========
PUBLIC_AUDIO_KEY=
PUBLIC_AUDIO_SECRET=
PUBLIC_AUDIO_ENDPOINT=https://fra1.digitaloceanspaces.com
PUBLIC_AUDIO_BUCKET=
PUBLIC_AUDIO_REGION=fra1
PUBLIC_AUDIO_CDN=https://your-public-audio-bucket.fra1.cdn.digitaloceanspaces.com

# ========== PRIVATE AUDIO (Private ACL - signed URLs generated separately) ==========
PRIVATE_AUDIO_KEY=
PRIVATE_AUDIO_SECRET=
PRIVATE_AUDIO_ENDPOINT=https://fra1.digitaloceanspaces.com
PRIVATE_AUDIO_BUCKET=
PRIVATE_AUDIO_REGION=fra1
