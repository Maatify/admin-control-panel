{
  "name": "maatify/storage",
  "description": "Production-ready file storage management library with complete upload, read, delete, and serve lifecycle. Supports semantic filename generation, pluggable validators, file metadata retrieval, HTTP Range streaming, and multiple storage adapters (local, DigitalOcean Spaces).",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "file-storage",
    "file-upload",
    "file-delete",
    "file-serve",
    "file-stream",
    "range-requests",
    "file-retrieval",
    "file-read",
    "storage",
    "image-upload",
    "video-upload",
    "audio-upload",
    "metadata",
    "validation",
    "semantic-naming",
    "signed-urls",
    "presigned-urls",
    "psr-7",
    "digitalocean-spaces",
    "s3-compatible",
    "multi-disk"
  ],
  "authors": [
    {
      "name": "Maatify Team",
      "email": "support@maatify.dev",
      "homepage": "https://maatify.dev"
    }
  ],
  "homepage": "https://github.com/maatify/storage",
  "support": {
    "issues": "https://github.com/maatify/storage/issues",
    "source": "https://github.com/maatify/storage"
  },
  "require": {
    "php": ">=8.2",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^2.0",
    "psr/container": "^2.0",
    "php-di/php-di": "^7.0",
    "aws/aws-sdk-php": "^3.0",
    "maatify/shared-common": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.12"
  },
  "suggest": {
    "ext-gd": "Required for image dimension validation",
    "psr/http-factory": "Required to use FileServeResponder"
  },
  "autoload": {
    "psr-4": {
      "Maatify\\Storage\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Maatify\\Storage\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --bootstrap tests/bootstrap.php tests/Unit --no-coverage",
    "test:coverage": "vendor/bin/phpunit --bootstrap tests/bootstrap.php tests/Unit --coverage-html=.phpunit.cache/code-coverage",
    "phpstan": "vendor/bin/phpstan analyse --level max src/",
    "analyze": [
      "@phpstan",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-di/php-di": true
    }
  },
  "minimum-stability": "stable"
}