{
  "name": "maatify/catalog",
  "description": "Standalone catalog category taxonomy foundation with translations.",
  "keywords": [
    "category",
    "taxonomy",
    "hierarchy",
    "translations",
    "php",
    "pdo",
    "maatify"
  ],
  "homepage": "https://github.com/Maatify/catalog",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Maatify",
      "email": "support@maatify.com",
      "homepage": "https://maatify.dev"
    }
  ],
  "support": {
    "issues": "https://github.com/Maatify/catalog/issues",
    "source": "https://github.com/Maatify/catalog"
  },
  "autoload": {
    "psr-4": {
      "Maatify\\Catalog\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Maatify\\Catalog\\Tests\\": "tests/"
    }
  },
  "require": {
    "maatify/exceptions": "^1.0",
    "php": ">=8.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "analyse": "phpstan analyse src tests --level=max",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.2.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
