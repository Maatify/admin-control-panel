{
  "name": "maatify/admin-control-panel",
  "type": "project",
  "description": "Runnable Admin Control Panel",
  "license": "MIT",

  "require": {
    "php": "^8.2",
    "ext-bcmath": "*",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-readline": "*",
    "ext-redis": "*",
    "aws/aws-sdk-php": "^3.0",
    "ezyang/htmlpurifier": "^4.19",
    "maatify/crypto": "^1.0",
    "maatify/event-logging": "^1.0",
    "maatify/exceptions": "^1.0",
    "maatify/persistence": "^1.0",
    "maatify/psr-logger": "^1.0",
    "maatify/shared-common": "^1.0",
    "php-di/php-di": "^7.0",
    "phpmailer/phpmailer": "^7.0",
    "pragmarx/google2fa": "^8.0",
    "ramsey/uuid": "^4.9",
    "respect/validation": "^2.4",
    "slim/psr7": "^1.8",
    "slim/slim": "^4.15",
    "slim/twig-view": "^3.4",
    "vlucas/phpdotenv": "^5.5"
  },

  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.12"
  },

  "autoload": {
    "psr-4": {
      "Maatify\\AdminControlPanel\\": "app/",
      "Maatify\\AdminKernel\\": "Modules/AdminKernel/",
      "Maatify\\EmailDelivery\\": "Modules/EmailDelivery",
      "Maatify\\InputNormalization\\": "Modules/InputNormalization",
      "Maatify\\Validation\\": "Modules/Validation",
      "Maatify\\RateLimiter\\": "Modules/RateLimiter",
      "Maatify\\AbuseProtection\\": "Modules/AbuseProtection",
      "Maatify\\I18n\\": "Modules/I18n",
      "Maatify\\AppSettings\\": "Modules/AppSettings",
      "Maatify\\LanguageCore\\": "Modules/LanguageCore",
      "Maatify\\ContentDocuments\\": "Modules/ContentDocuments",
      "Maatify\\Verification\\": "Modules/Verification",
      "Maatify\\Currency\\": "Modules/currency/src",
      "Maatify\\CurrencySlim\\": "Modules/CurrencySlim/src",
      "Maatify\\Storage\\": "Modules/Storage/src",
      "Maatify\\ImageProfile\\": "Modules/ImageProfile/src",
      "Maatify\\WebsiteUiTheme\\": "Modules/WebsiteUiTheme/src",
      "Maatify\\ExchangeRates\\": "Modules/ExchangeRates/src",
      "Maatify\\ExchangeRatesSlim\\": "Modules/ExchangeRatesSlim/src",
      "Maatify\\Geo\\": "Modules/geo/src",
      "Maatify\\GeoSlim\\": "Modules/GeoSlim/src",
      "Maatify\\Settings\\": "Modules/Settings/src",
      "Maatify\\SettingsSlim\\": "Modules/SettingsSlim/src"
    }
  },

  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/admin/",
      "Maatify\\Geo\\Tests\\": "Modules/geo/tests/"
    }
  },

  "scripts": {
    "run-http:admin": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S 0.0.0.0:8081 -t public/admin"
    ],
    "test": "phpunit",
    "test:admin": "phpunit --configuration phpunit.admin.xml",
    "test:non-integration": "phpunit --configuration phpunit.admin.xml --exclude-filter Integration",
    "test:integration": "php scripts/dev/run_admin_integration_tests.php --mode=clone --refresh --",
    "analyse": "phpstan analyse app Modules --level=max --memory-limit=2G",
    "permission-lint": "@php tools/permission_linter.php",
    "Permission Linter": "@permission-lint",
    "check:composer": "composer validate --strict",
    "check:analyse": "@analyse",
    "check:non-integration": "@test:non-integration",
    "check:integration": "@test:integration",
    "check:permissions": "@permission-lint",
    "check:whitespace": [
      "git diff --check",
      "git diff --cached --check",
      "if [ -n \"$CI_WHITESPACE_RANGE\" ]; then git diff --check \"$CI_WHITESPACE_RANGE\"; elif git diff --quiet && git diff --cached --quiet; then git show --check --format= --no-ext-diff HEAD; else git diff --check; git diff --cached --check; fi"
    ],
    "check:module:image-profile": "phpunit --configuration Modules/ImageProfile/phpunit.xml.dist",
    "check:module:settings": "phpunit --configuration Modules/Settings/phpunit.xml.dist --bootstrap vendor/autoload.php",
    "check:module:storage": "phpunit --configuration Modules/Storage/tests/phpunit.xml",
    "check:module:geo": "phpunit --configuration Modules/geo/phpunit.xml --bootstrap vendor/autoload.php",
    "check:all": [
      "@check:composer",
      "@check:analyse",
      "@check:non-integration",
      "@check:integration",
      "@check:permissions",
      "@check:whitespace"
    ]
  },

  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },

  "minimum-stability": "stable",
  "prefer-stable": true
}
